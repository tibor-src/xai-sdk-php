{
    "name": "xai-official/sdk-php",
    "description": "Official PHP SDK for the SpaceXAI API",
    "keywords": ["xai", "spacexai", "grok", "ai", "sdk", "php"],
    "license": "Apache-2.0",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.7",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "XaiOfficial\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XaiOfficial\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
