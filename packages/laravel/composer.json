{
    "name": "xai-sdk/laravel",
    "description": "Laravel integration for the SpaceXAI PHP SDK",
    "keywords": ["xai", "spacexai", "grok", "laravel", "sdk"],
    "license": "Apache-2.0",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "xai-official/sdk-php": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "XaiSdk\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XaiSdk\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XaiSdk\\Laravel\\XaiServiceProvider"
            ],
            "aliases": {
                "Xai": "XaiSdk\\Laravel\\Facades\\Xai"
            }
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ]
}
